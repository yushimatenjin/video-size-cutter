{
  "name": "video-size-cutter",
  "version": "1.0.0",
  "description": "DiscordやSNSに送る動画を指定サイズに圧縮するブラウザ内ツール（ffmpeg.wasm版）",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
